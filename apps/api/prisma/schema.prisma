generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  OWNER
  ADMIN
  USER
  VIEWER
}

enum AssetStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
  RETIRED
}

enum OrganizationLocationType {
  PLANT
  WAREHOUSE
  BRANCH
  CLIENT_SITE
  PROJECT_SITE
  SERVICE_SITE
  OTHER
}

enum LocationSource {
  GPS
  ORGANIZATION_LOCATION
  MANUAL
  DEVICE_TIMEZONE
  UTC_FALLBACK
}

enum RestaurantStation {
  KITCHEN
  BAR
}

enum RestaurantStaffRole {
  RESTAURANT_ADMIN
  KITCHEN
  BAR
  WAITER
}

enum RestaurantStaffAvailability {
  AVAILABLE
  BREAK
  TEMPORARILY_UNAVAILABLE
  OFF_SHIFT
}

enum RestaurantCourse {
  DRINK
  STARTER
  MAIN
  OTHER
}

enum RestaurantItemStatus {
  RECEIVED
  ACCEPTED
  PREPARING
  READY
  DELIVERED
  CANCELLED
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users               User[]
  assets              Asset[]
  locations           OrganizationLocation[]
  restaurantTables    RestaurantTable[]
  restaurantMenuItems RestaurantMenuItem[]
  restaurantOrders    RestaurantOrder[]

  @@map("organizations")
}

model RestaurantTable {
  id             String            @id @default(uuid())
  organizationId String
  name           String
  code           String            @unique @default(uuid())
  active         Boolean           @default(true)
  createdAt      DateTime          @default(now())
  waiterId       String?
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  waiter         User?             @relation("RestaurantWaiterTables", fields: [waiterId], references: [id], onDelete: SetNull)
  orders         RestaurantOrder[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@index([waiterId])
  @@map("restaurant_tables")
}

model RestaurantMenuItem {
  id             String                @id @default(uuid())
  organizationId String
  name           String
  description    String?
  price          Int
  station        RestaurantStation
  course         RestaurantCourse
  active         Boolean               @default(true)
  createdAt      DateTime              @default(now())
  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  orderItems     RestaurantOrderItem[]

  @@index([organizationId, active])
  @@map("restaurant_menu_items")
}

model RestaurantOrder {
  id             String                @id @default(uuid())
  organizationId String
  tableId        String
  accessCode     String                @unique @default(uuid())
  requestId      String                @unique
  createdAt      DateTime              @default(now())
  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  table          RestaurantTable       @relation(fields: [tableId], references: [id])
  items          RestaurantOrderItem[]

  @@index([organizationId, createdAt])
  @@map("restaurant_orders")
}

model RestaurantOrderItem {
  id          String                @id @default(uuid())
  orderId     String
  menuItemId  String
  name        String
  price       Int
  station     RestaurantStation
  course      RestaurantCourse
  quantity    Int
  status      RestaurantItemStatus  @default(RECEIVED)
  acceptedAt  DateTime?
  readyAt     DateTime?
  deliveredAt DateTime?
  order       RestaurantOrder       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem    RestaurantMenuItem    @relation(fields: [menuItemId], references: [id])
  events      RestaurantItemEvent[]

  @@index([station, status])
  @@map("restaurant_order_items")
}

model RestaurantItemEvent {
  id        String               @id @default(uuid())
  itemId    String
  actorId   String?
  status    RestaurantItemStatus
  note      String?
  createdAt DateTime             @default(now())
  item      RestaurantOrderItem  @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId, createdAt])
  @@map("restaurant_item_events")
}

model RestaurantStaffEvent {
  id             String                      @id @default(uuid())
  organizationId String
  userId         String
  actorId        String
  availability   RestaurantStaffAvailability
  reason         String?
  createdAt      DateTime                    @default(now())

  @@index([organizationId, createdAt])
  @@index([userId, createdAt])
  @@map("restaurant_staff_events")
}

model OrganizationLocation {
  id             String                   @id @default(uuid())
  organizationId String
  name           String
  nameKey        String
  type           OrganizationLocationType @default(OTHER)

  country String
  region  String?
  city    String?
  address String?

  latitude  Decimal? @db.Decimal(10, 7)
  longitude Decimal? @db.Decimal(10, 7)
  timezone  String?

  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  scanEvents ScanEvent[]

  @@unique([organizationId, nameKey])
  @@index([organizationId])
  @@index([active])
  @@map("organization_locations")
}

model User {
  id                     String                      @id @default(uuid())
  organizationId         String
  email                  String
  name                   String
  passwordHash           String
  role                   UserRole                    @default(USER)
  restaurantRole         RestaurantStaffRole?
  restaurantAvailability RestaurantStaffAvailability @default(AVAILABLE)
  createdAt              DateTime                    @default(now())
  updatedAt              DateTime                    @updatedAt

  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  scanEvents       ScanEvent[]
  refreshTokens    RefreshToken[]
  restaurantTables RestaurantTable[] @relation("RestaurantWaiterTables")

  @@unique([organizationId, email])
  @@index([organizationId])
  @@map("users")
}

model Asset {
  id             String      @id @default(uuid())
  organizationId String
  name           String
  assetTag       String
  status         AssetStatus @default(ACTIVE)
  location       String?
  description    String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  qrCode       QrCode?
  scanEvents   ScanEvent[]

  @@unique([organizationId, assetTag])
  @@index([organizationId])
  @@index([status])
  @@map("assets")
}

model QrCode {
  id        String   @id @default(uuid())
  assetId   String   @unique
  code      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@map("qr_codes")
}

model ScanEvent {
  id                     String          @id @default(uuid())
  assetId                String
  userId                 String?
  organizationLocationId String?
  locationSource         LocationSource?
  scannedAt              DateTime        @default(now())
  notes                  String?
  locationName           String?
  country                String?
  region                 String?
  city                   String?
  address                String?

  latitude         Decimal? @db.Decimal(10, 7)
  longitude        Decimal? @db.Decimal(10, 7)
  locationAccuracy Decimal? @db.Decimal(10, 2)
  timezone         String?
  timezoneOffset   Int?

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  user  User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  organizationLocation OrganizationLocation? @relation(fields: [organizationLocationId], references: [id], onDelete: SetNull)

  @@index([assetId])
  @@index([userId])
  @@index([scannedAt])
  @@index([timezone])
  @@index([organizationLocationId])
  @@map("scan_events")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}
